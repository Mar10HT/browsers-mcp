{
  "name": "browsers-mcp-server",
  "version": "1.0.0",
  "description": "MCP server that turns browsers into full debugging tools accessible from an LLM chat",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "tsc && node --test dist/tools/accessibility.test.js"
  },
  "keywords": [
    "mcp",
    "browser",
    "devtools",
    "playwright"
  ],
  "license": "MIT",
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "playwright": "^1.52.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
